{
  "manifest_version": 3,
  "name": "B哩B哩主题 / Bilibili Theme Customizer",
  "version": "2.6.1",
  "minimum_chrome_version": "114",
  "description": "自定义哔哩哔哩背景和玻璃效果。Customize Bilibili backgrounds and glass effects.",
  "permissions": ["storage", "unlimitedStorage"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "settings.js"
  },
  "action": {
    "default_title": "B哩B哩主题 / Bilibili Theme Customizer",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.bilibili.com/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
